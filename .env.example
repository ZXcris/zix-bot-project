# Copia este archivo a .env y rellena tus valores.
# NUNCA subas .env al repositorio (ya está en .gitignore).

# --- Proveedor de IA (v0.3) ---
# "groq" (defecto) o "xkiro" (gateway OpenAI-compatible con modelos gratis)
AI_PROVIDER=groq

# Obtén una API key gratuita en https://console.groq.com (no requiere tarjeta)
GROQ_API_KEY=

# xKiro: crea cuenta en https://xkiro.com, Console -> API Keys (40+ modelos
# gratis, sin tarjeta). Modelos gratis con tool calling para el agente:
# mistralai/mistral-small-2603, minimax/minimax-m3:free
XKIRO_API_KEY=
XKIRO_MODEL=qwen/qwen3.8-max:free
XKIRO_FALLBACK_MODEL=minimax/minimax-m3:free
XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_TIMEOUT_SECONDS=30

# Modelo principal (free tier, soporta tool calling)
GROQ_MODEL=qwen/qwen3.6-27b

# Modelo de respaldo si se agota la cuota del principal (free tier, tool calling)
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Máximo de iteraciones del bucle del agente (evita bucles infinitos)
MAX_AGENT_ITERATIONS=10

# Timeout de las peticiones a Groq en segundos
GROQ_TIMEOUT_SECONDS=30

# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Audio: elegir micrófono ---
# Los tres van vacíos o a 0 a propósito: 0/"" = lo que elija el sistema.
# En el equipo de quien clone esto el micrófono correcto es otro, así que
# adivinarlo aquí rompería la captura.
# Nombre o índice del dispositivo. Vacío = el del sistema.
AUDIO_INPUT_DEVICE=
# Frecuencia a la que graba tu micro. Si oyes la voz como un pitido muy
# agudo o muy grave, tu dispositivo no trabaja a 16000 Hz: pon aquí su
# frecuencia nativa y ZIX re-muestrea.
AUDIO_INPUT_SAMPLERATE=0
# Canales del dispositivo. 0 = los máximos que admita.
AUDIO_INPUT_CHANNELS=0

# --- Audio (v0.2) ---
# Frecuencia de muestreo del micrófono (16 kHz es lo estándar para voz)
VOICE_SAMPLE_RATE=16000
# Bloque de audio por iteración: 1280 muestras = 80 ms a 16 kHz (openWakeWord)
VOICE_BLOCK_SIZE=1280
# RMS por debajo de esto se considera silencio (audio float32 en [-1, 1])
VAD_THRESHOLD=0.02
# Silencio necesario para dar por terminada la frase (segundos)
VAD_SILENCE_TIMEOUT_SECONDS=0.8
# Duración mínima de habla para no descartar por ruido (segundos)
VAD_MIN_SPEECH_SECONDS=0.3
# Duración máxima de una frase (segundos)
VOICE_MAX_UTTERANCE_SECONDS=30
# Ventana de conversación temporal tras la respuesta (segundos)
VOICE_CONVERSATION_TIMEOUT_SECONDS=10
# Mínimo de caracteres para considerar una transcripción "orden válida"
VOICE_ORDER_MIN_CHARS=2
VOICE_CONTINUOUS_MODE=0

# --- Wake word (v0.2) ---
# TEMPORAL: hey_jarvis es el único modelo propio que existe hoy. El
# "zix.onnx" que entrenamos con tu voz todavía no está listo (el de
# septiembre respondía a su propio clip de entrenamiento y fallaba con
# voz real). Cuando esté verificado con clips retenidos, aquí pasará a zix.
WAKE_WORD_MODEL=hey_jarvis
# Puntuación mínima para activar (0-1)
WAKE_WORD_THRESHOLD=0.5
# Directorio para futuros modelos propios (p. ej. zix.onnx)
WAKE_MODELS_DIR=models/wakeword
# Supresión de ruido con speexdsp en vez de webrtcvad. Poner 1 exige
# tener instalado speexdsp-ns; si no, ZIX avisa y sigue con webrtcvad.
# Recomendado si el micrófono recoge mucho zumbido o ruido de fondo.
# WAKE_WORD_SPEEX_NS=0

# --- STT (v0.2) ---
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=es

# --- STT: proveedor y privacidad -------------------------------------------
# groq  = envia el audio a api.groq.com (rapido, necesita GROQ_API_KEY)
# local = transcribe aqui con faster-whisper; el audio NO sale del equipo
# auto  = local si faster-whisper esta instalado, si no groq
#
# Por defecto "auto" y no "groq": asi quien clone esto no manda su voz a
# un servidor sin haberlo decidido. Si instalas faster-whisper, ni siquiera
# necesitas tocar esta linea para que el audio no salga del equipo.
STT_PROVIDER=auto

# Interruptor de privacidad. Con 0 NO se envia audio a ningun servidor: si el
# proveedor activo es la nube, el pipeline se niega a transcribir. Es el freno
# de emergencia ante una activacion falsa de la palabra de activacion.
#
# Esta en 1 (permitido) por defecto porque sin el, un fallo de microfono con
# STT_PROVIDER=groq deja a ZIX sin poder responder y no hay forma de
# diagnosticar. Ponerlo a 0 es lo recomendado si ya tienes local funcionando.
STT_ALLOW_CLOUD=1

# Modelo local (solo con STT_PROVIDER=local o auto). Descarga aprox:
#   tiny ~75 MB · base ~145 MB · small ~460 MB · medium ~1,5 GB · large-v3 ~3 GB
# STT_LOCAL_MODEL=base
# STT_LOCAL_DEVICE=cpu
# STT_LOCAL_COMPUTE_TYPE=int8

# Filtro LOCAL previo a cualquier subida: descarta audio cuyo porcentaje de
# voz (Silero) este por debajo, y audio mas largo que el tope. Reduce lo que
# sale; no lo elimina, porque decidir si el contenido es una orden exigiria
# transcribir, que es justo lo que sube el audio.
# STT_MIN_SPEECH_RATIO=0.15
# STT_MAX_SECONDS=15.0

# --- TTS (v0.2) ---
PIPER_VOICE=es_MX-claude-high
PIPER_MODELS_DIR=models/piper
# Datos de espeak-ng (deben estar en ruta ASCII; por defecto %LOCALAPPDATA%\zix\espeak-ng-data)
PIPER_ESPEAK_DATA_DIR=

# --- Ejecución de voz (v0.2) ---
# Grabaciones temporales de frases y respuestas (para depurar)
VOICE_RUNTIME_DIR=runtime