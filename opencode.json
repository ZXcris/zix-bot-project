{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx.cmd", "-y", "chrome-devtools-mcp@latest", "--autoConnect"]
    }
  },
  "provider": {
    "xkiro": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "xKiro (gratis)",
      "options": {
        "baseURL": "https://api.xkiro.com/v1",
        "apiKey": "{env:XKIRO_API_KEY}"
      },
      "models": {
        "qwen/qwen3.8-max:free": {
          "name": "Qwen3.8 Max (gratis)",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "reasoning": true,
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "qwen/qwen3-coder-plus:free": {
          "name": "Qwen3 Coder Plus (gratis)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "reasoning": true,
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "mistralai/devstral-medium": {
          "name": "Devstral Medium (gratis)",
          "limit": {
            "context": 256000,
            "output": 16384
          },
          "reasoning": false,
          "tool_call": true
        },
        "mistralai/codestral-2508": {
          "name": "Codestral (gratis)",
          "limit": {
            "context": 256000,
            "output": 16384
          },
          "reasoning": false,
          "tool_call": true
        }
      }
    }
  }
}